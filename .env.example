# =================================================================
# Sentinel AI - Production & Development Environment Configuration
# =================================================================

# Core
SENTINEL_ENV=development
SENTINEL_DEBUG=false
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://sentinel:sentinel_dev_password@localhost:5432/sentinel_db

# Docker Compose Path & Timeouts
SENTINEL_COMPOSE_DIR=.
DOCKER_TIMEOUT=30

# Security & JWT Authentication
SENTINEL_SECRET_KEY=sentinel-production-grade-super-secret-key-999-ai-ops
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Autonomous Remediation & Safety Guardrails
AUTO_REMEDIATION_ENABLED=true
SAFETY_COOLDOWN_SECONDS=20
SAFETY_MAX_RESTARTS_PER_WINDOW=3
SAFETY_WINDOW_MINUTES=10
SAFETY_MAX_BLAST_RADIUS_AUTONOMOUS=3

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,*
